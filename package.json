{
  "name": "cursor-bridge",
  "version": "1.0.0",
  "description": "MCP server that gives Claude Code control over Cursor's chat/agent panels via CDP, plus workspace filesystem tools",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "node --test dist/*.test.js",
    "prepare": "npm run build"
  },
  "bin": {
    "cursor-bridge": "./dist/index.js"
  },
  "keywords": ["mcp", "vscode", "cursor", "claude", "ide", "modelcontextprotocol", "cdp", "chrome-devtools-protocol"],
  "license": "MIT",
  "author": "KloutDevs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KloutDevs/cursor-bridge.git"
  },
  "homepage": "https://github.com/KloutDevs/cursor-bridge#readme",
  "bugs": {
    "url": "https://github.com/KloutDevs/cursor-bridge/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
