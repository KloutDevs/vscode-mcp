{
  "name": "cursor-mcp-bridge",
  "displayName": "Cursor MCP Bridge",
  "description": "Exposes Cursor/VS Code commands over a local HTTP server for the vscode-mcp MCP server",
  "version": "1.0.5",
  "publisher": "kloutdevs",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cursorMcpBridge.showStatus",
        "title": "MCP Bridge: Show Status"
      },
      {
        "command": "cursorMcpBridge.restart",
        "title": "MCP Bridge: Restart HTTP Server"
      }
    ],
    "configuration": {
      "title": "Cursor MCP Bridge",
      "properties": {
        "cursorMcpBridge.port": {
          "type": "number",
          "default": 9421,
          "description": "Port for the local HTTP bridge server"
        }
      }
    }
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.7.0"
  }
}
